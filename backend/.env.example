# Copy to .env for local development. Never commit backend/.env.
DEBUG=true
DEMO_MODE=false
TEST_MODE=false
AUTH_SECRET=change-this-development-secret-before-deploying
SESSION_HOURS=24
DATABASE_URL=sqlite+aiosqlite:///./studymind.db
GEMINI_API_KEY=
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIRECTORY=data/uploads
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
